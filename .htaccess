Options -Indexes
<Files "*.php">
    Order Allow,Deny
    Allow from all
</Files>

<Directory "uploads">
    Options -Indexes
    <FilesMatch "\.(jpg|jpeg|png|gif)$">
        Order Allow,Deny
        Allow from all
    </FilesMatch>
</Directory>

<Files "db_config.php">
    Order Deny,Allow
    Deny from all
</Files>